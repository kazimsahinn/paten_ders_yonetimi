DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production/preview defaults when DJANGO_DEBUG=0.
DJANGO_SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# Supabase bağlantısı hazır olduğunda doldurulabilir.
DATABASE_URL=
DB_SSLMODE=require

DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-this-locally

# Fernet key for encrypted student safety fields. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Kimlik doğrulama kötüye kullanım sınırları.
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900
AUTH_PASSWORD_RESET_ATTEMPTS=3
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_BLOCK_SECONDS=3600
